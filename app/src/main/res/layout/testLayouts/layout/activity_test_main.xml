<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/test_main"
    tools:context=".testFiler.MainTestActivity">

    <include layout="@layout/toolbar"
        android:id="@+id/toolbarMain"/>

    <TextView
        android:layout_width="299dp"
        android:layout_height="91dp"
        android:layout_marginHorizontal="50dp"
        android:layout_marginVertical="100dp"
        android:gravity="center"
        android:text="Test-homepage"
        android:textSize="40sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="310dp"
        android:layout_height="140dp"
        android:layout_marginHorizontal="50dp"
        android:layout_marginVertical="220dp"
        android:text="Dette er forsiden for test-filene. Naviger rundt via knappene nedenfor"
        android:textSize="25sp"
        android:gravity="center"
        android:background="@drawable/textview_border" />

    <Button
        android:id="@+id/butEn"
        android:text="stasjonverdier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/butTo"/>

    <Button
        android:id="@+id/butTo"
        android:text="stasjoner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/butTre"/>

    <Button
        android:id="@+id/butTre"
        android:text="Maps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>


</RelativeLayout>