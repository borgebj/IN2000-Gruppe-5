<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment" >

    <ImageView
        android:id="@+id/iconLocation_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/ic_location_marker"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="32dp" />

    <TextView
        android:id="@+id/text_home"
        android:layout_width="257dp"
        android:layout_height="96dp"
        android:gravity="center"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.06" />


    <ImageButton
        android:id="@+id/info_home"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/ic_info"
        app:layout_constraintBottom_toTopOf="@+id/donut_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.92"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_home"
        app:layout_constraintVertical_bias="1.0" />

    <app.futured.donut.DonutProgressView
        android:id="@+id/donut_view"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:gravity="center"
        app:donut_bgLineColor="@color/light_gray"
        app:donut_gapAngle="270"
        app:donut_gapWidth="80"
        app:donut_strokeWidth="25dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toTopOf="@+id/testFiler_knapp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_home" />

    <TextView
        android:id="@+id/aqiSentence_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        android:gravity="center"
        android:text="Luftkvaliteten er bra"
        android:textColor="@color/black"
        android:textSize="25dp"
        app:layout_constraintBottom_toTopOf="@+id/testFiler_knapp"
        app:layout_constraintEnd_toStartOf="@+id/smiley_location"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/donut_view"
        app:layout_constraintVertical_bias="0.577" />

    <ImageView
        android:id="@+id/smiley_home"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ic_smiley_lvl1"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="577dp"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/testFiler_knapp"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:backgroundTint="@color/gray"
        android:text="Test-filer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>