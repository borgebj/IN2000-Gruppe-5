<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".ui.home.HomeFragment" >


    <ImageButton
        android:id="@+id/iconLocation_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/ic_location_marker"
        app:layout_constraintEnd_toStartOf="@+id/text_home"
        app:layout_constraintHorizontal_bias="0.842"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_home"
        android:layout_width="257dp"
        android:layout_height="96dp"
        android:gravity="center"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_info"
        android:layout_width="257dp"
        android:layout_height="24dp"
        android:layout_marginTop="65dp"
        android:layout_marginBottom="17dp"
        android:gravity="center"
        android:text="@string/nærmeste"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/donut_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/info_home"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ic_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/text_home"
        app:layout_constraintTop_toTopOf="parent" />

    <app.futured.donut.DonutProgressView
        android:id="@+id/donut_view"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginBottom="80dp"
        android:gravity="center"
        app:donut_bgLineColor="@color/light_gray"
        app:donut_gapAngle="270"
        app:donut_gapWidth="80"
        app:donut_strokeWidth="25dp"
        app:layout_constraintBottom_toBottomOf="@id/recommendation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.472"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_home"
        app:layout_constraintVertical_bias="0.203" />

    <TextView
        android:id="@+id/donutNmbrsHomeMin"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        android:gravity="end"
        android:textColor="@color/gray"
        android:textSize="18sp"
        android:text="0"
        app:layout_constraintBottom_toTopOf="@+id/aqiLvlHome"
        app:layout_constraintEnd_toEndOf="@+id/donut_view"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="@+id/donut_view"
        app:layout_constraintTop_toTopOf="@+id/donut_view"
        app:layout_constraintVertical_bias="0.232" />

    <TextView
        android:id="@+id/donutNmbrsHomeMax"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        android:gravity="start"
        android:textColor="@color/gray"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/aqiLvlHome"
        app:layout_constraintEnd_toEndOf="@+id/donut_view"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="@+id/donut_view"
        app:layout_constraintTop_toTopOf="@+id/donut_view"
        app:layout_constraintVertical_bias="0.232" />

    <TextView
        android:id="@+id/aqiSentence_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="@id/recommendation"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/donut_view"
        app:layout_constraintVertical_bias="0.347" />


    <Button
        android:id="@+id/recommendation"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="@color/gray"
        android:text="@string/anbefalinger"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aqiSentence_home"
        app:layout_constraintVertical_bias="0.210" />

    <ImageView
        android:id="@+id/smiley_home"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="@+id/donut_view"
        app:layout_constraintEnd_toEndOf="@+id/donut_view"
        app:layout_constraintStart_toStartOf="@+id/donut_view"
        app:layout_constraintTop_toTopOf="@+id/donut_view"
        app:layout_constraintVertical_bias="0.765"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/aqiLvlHome"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:foregroundGravity="center"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="31sp"
        app:layout_constraintBottom_toTopOf="@+id/smiley_home"
        app:layout_constraintEnd_toEndOf="@+id/donut_view"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="@+id/donut_view" />

    <TextView
        android:id="@+id/aqiTypeHome"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@id/aqiLvlHome"
        app:layout_constraintEnd_toEndOf="@+id/donut_view"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="@+id/donut_view" />


</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>