<?xml version="1.0" encoding="utf-8"?>


<resources>
    <style name="Divider">
        <item name="android:background">@color/black</item> //you can give your color here. that will change all divider color in your app.
    </style>

    <style name="Divider.Horizontal" parent="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item> // You can change thickness here.

    </style>

    <style name="Divider.Vertical" parent="Divider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>


<!--animasjon for alertdialogs-->
    <style name="DialogThNext">
        <item name="android:windowEnterAnimation">@transition/slide_left</item>
        <item name="android:windowExitAnimation">@transition/slide_right</item>
    </style>

    <style name="DialogThNextNext">
        <item name="android:windowExitAnimation">@transition/slide_right</item>
    </style>

    <style name="DialogThBack">
        <item name="android:windowEnterAnimation">@transition/slide_right</item>
        <item name="android:windowExitAnimation">@transition/slide_left</item>
    </style>

    <style name="DialogThUpDown">
        <item name="android:windowEnterAnimation">@transition/slide_up</item>
        <item name="android:windowExitAnimation">@transition/slide_bottom</item>
    </style>

    <style name="DialogThOpen">
        <item name="android:windowEnterAnimation">@transition/slide_up</item>
    </style>

    <style name="DialogThClose">
        <item name="android:windowExitAnimation">@transition/slide_bottom</item>
    </style>


    <!--ikke slett, men ikke bruk - for alertdialogs
    <style name="DialogAnimation">
    <item name="android:windowEnterAnimation">@android:anim/slide_in_left</item>
    <item name="android:windowExitAnimation">@android:anim/slide_out_right</item>
    </style>
    -->



</resources>